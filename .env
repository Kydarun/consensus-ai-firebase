NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_AUTH_DOMAIN
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID

# Add Firebase Admin SDK Key (Generate from Firebase Console -> Project Settings -> Service Accounts)
# Keep this secure, DO NOT commit the actual key to public repositories.
# It should be a JSON string, often stored multiline in env vars.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", ...}'


# Add Stripe keys later
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
GOOGLE_GENAI_API_KEY=